    "titles": {
      "de": "Die hungrige Maus",
      "pl": "Głodna mysz",
      "en": "The hungry mouse"
    },
    "sentences": [
      "In einem alten Haus lebt eine Maus.",
      "Die Maus ist klein und schnell.",
      "Sie ist oft hungrig.",
      "In der Küche liegt Käse.",
      "Der Käse riecht gut.",
      "Die Maus läuft leise über den Boden.",
      "Sie findet den Käse auf dem Tisch.",
      "Die Katze schläft auf dem Stuhl.",
      "Die Maus nimmt ein Stück Käse.",
      "Sie isst sehr schnell.",
      "Plötzlich wacht die Katze auf.",
      "Die Maus rennt unter den Tisch.",
      "Die Katze ist zu langsam.",
      "Die Maus ist sicher.",
      "Am Abend schläft die Maus im Loch.",
      "Sie träumt von mehr Käse.",
      "Der Mond scheint durch das Fenster.",
      "Die kleine Maus ist zufrieden."
    ],
    "translations": {
      "pl": [
        "W starym domu mieszka mysz.",
        "Mysz jest mała i szybka.",
        "Często jest głodna.",
        "W kuchni leży ser.",
        "Ser dobrze pachnie.",
        "Mysz cicho biegnie po podłodze.",
        "Znajduje ser na stole.",
        "Kot śpi na krześle.",
        "Mysz bierze kawałek sera.",
        "Je bardzo szybko.",
        "Nagle kot się budzi.",
        "Mysz biegnie pod stół.",
        "Kot jest za wolny.",
        "Mysz jest bezpieczna.",
        "Wieczorem mysz śpi w dziurze.",
        "Śni o większej ilości sera.",
        "Księżyc świeci przez okno.",
        "Mała mysz jest zadowolona."
      ],
      "en": [
        "In an old house lives a mouse.",
        "The mouse is small and fast.",
        "It is often hungry.",
        "Cheese lies in the kitchen.",
        "The cheese smells good.",
        "The mouse runs quietly across the floor.",
        "It finds the cheese on the table.",
        "The cat sleeps on the chair.",
        "The mouse takes a piece of cheese.",
        "It eats very quickly.",
        "Suddenly the cat wakes up.",
        "The mouse runs under the table.",
        "The cat is too slow.",
        "The mouse is safe.",

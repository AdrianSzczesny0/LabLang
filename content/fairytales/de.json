    "titles": {
      "de": "Rotkäppchen",
      "pl": "Czerwony Kapturek",
      "en": "Little Red Riding Hood"
    },
    "sentences": [
      "Es war einmal ein kleines Mädchen.",
      "Das Mädchen hat eine rote Mütze.",
      "Alle sagen: „Rotkäppchen!“",
      "Rotkäppchen geht in den Wald.",
      "Im Wald ist es ruhig und grün.",
      "Rotkäppchen sieht einen Wolf.",
      "Der Wolf ist groß und grau.",
      "„Guten Tag!“, sagt der Wolf.",
      "„Guten Tag!“, sagt Rotkäppchen.",
      "Rotkäppchen geht zur Großmutter.",
      "Die Großmutter wohnt in einem kleinen Haus.",
      "Rotkäppchen klopft an die Tür.",
      "„Herein!“, ruft die Großmutter.",
      "Rotkäppchen gibt der Großmutter Brot und Milch.",
      "Die Großmutter ist glücklich.",
      "Sie essen zusammen und trinken Tee.",
      "Rotkäppchen geht nach Hause.",
      "Der Tag ist schön und warm."
    ],
    "translations": {
      "pl": [
        "Było sobie mała dziewczynka.",
        "Dziewczynka ma czerwony czepek.",
        "Wszyscy mówią: „Czerwony Kapturek!“",
        "Czerwony Kapturek idzie do lasu.",
        "W lesie jest cicho i zielono.",
        "Czerwony Kapturek widzi wilka.",
        "Wilk jest duży i szary.",
        "„Dzień dobry!“, mówi wilk.",
        "„Dzień dobry!“, mówi Czerwony Kapturek.",
        "Czerwony Kapturek idzie do babci.",
        "Babcia mieszka w małym domu.",
        "Czerwony Kapturek puka do drzwi.",
        "„Wejdź!“, woła babcia.",
        "Czerwony Kapturek daje babci chleb i mleko.",
        "Babcia jest szczęśliwa.",
        "Jedzą razem i piją herbatę.",
        "Czerwony Kapturek idzie do domu.",
        "Dzień jest piękny i ciepły."
      ],
      "en": [
        "Once upon a time there was a little girl.",
        "The girl has a red cap.",
        "Everyone says: \"Little Red Riding Hood!\"",
        "Little Red Riding Hood goes into the forest.",
        "In the forest it is quiet and green.",
        "She sees a wolf.",
        "The wolf is big and grey.",
        "\"Good day!\", says the wolf.",
        "\"Good day!\", she says.",
        "She goes to her grandmother.",
        "Grandmother lives in a small house.",
        "She knocks on the door.",
        "\"Come in!\", calls grandmother.",
        "She gives grandmother bread and milk.",
        "Grandmother is happy.",
        "They eat together and drink tea.",
        "She goes home.",
        "The day is beautiful and warm."
      ]
    },

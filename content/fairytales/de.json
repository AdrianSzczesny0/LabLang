    "sentences": [
      "Anna geht in die Bäckerei.",
      "Die Bäckerei ist hell und warm.",
      "„Guten Morgen!“, sagt der Bäcker.",
      "„Guten Morgen!“, sagt Anna.",
      "Anna möchte ein Brötchen.",
      "Sie möchte auch ein kleines Brot.",
      "„Das kostet zwei Euro“, sagt der Bäcker.",
      "Anna bezahlt mit Münzen.",
      "Der Bäcker gibt Anna eine Tüte.",
      "In der Tüte sind das Brötchen und das Brot.",
      "Anna riecht das frische Brot.",
      "Das Brot ist warm und gut.",
      "„Danke schön!“, sagt Anna.",
      "„Bitte schön!“, sagt der Bäcker.",
      "Anna geht nach Hause.",
      "Zu Hause isst sie das Brötchen.",
      "Es schmeckt sehr gut.",
      "Anna ist zufrieden."
    ],
    "translations": {
      "pl": [
        "Ana idzie do piekarni.",
        "Piekarnia jest jasna i ciepła.",
        "„Dzień dobry!“, mówi piekarz.",
        "„Dzień dobry!“, mówi Ana.",
        "Ana chce bułkę.",
        "Chce też mały chleb.",
        "„To kosztuje dwa euro“, mówi piekarz.",
        "Ana płaci monetami.",
        "Piekarz daje Annie torbę.",
        "W torbie są bułka i chleb.",
        "Ana czuje zapach świeżego chleba.",
        "Chleb jest ciepły i dobry.",
        "„Dziękuję!“, mówi Ana.",
        "„Proszę bardzo!“, mówi piekarz.",
        "Ana idzie do domu.",
        "W domu je bułkę.",
        "Smakuje bardzo dobrze.",
        "Ana jest zadowolona."
      ],
      "en": [
        "Anna goes to the bakery.",
        "The bakery is bright and warm.",
        "\"Good morning!\", says the baker.",
        "\"Good morning!\", says Anna.",
        "Anna wants a roll.",
        "She also wants a small loaf.",
        "\"That costs two euros,\" says the baker.",
        "Anna pays with coins.",
        "The baker gives Anna a bag.",
        "The bag has the roll and the bread.",
        "Anna smells the fresh bread.",
        "The bread is warm and good.",
        "\"Thank you!\", says Anna.",
        "\"You're welcome!\", says the baker.",
        "Anna goes home.",
        "At home she eats the roll.",
        "It tastes very good.",
        "Anna is satisfied."
      ]
